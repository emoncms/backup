[Unit]
Description=Weekly Emoncms backup drive verify
Documentation=https://github.com/emoncms/backup

[Timer]
# Sunday, a few hours after the daily backup would have run
OnCalendar=Sun *-*-* 04:00:00
RandomizedDelaySec=1h
Persistent=true

Unit=emoncms-drive-backup-verify.service

[Install]
WantedBy=timers.target
